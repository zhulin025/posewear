{
  "name": "posewear",
  "private": true,
  "description": "衣姿 PoseWear：姿势、服装、人像参考图库与 AI 试穿工作台",
  "license": "MIT",
  "scripts": {
    "build": "python3 build.py",
    "serve": "python3 -m http.server 8787 -d dist",
    "test": "node tests/v12.js && node tests/v13.js",
    "prepare:pages": "python3 scripts/prepare-pages.py --assets-origin https://posewear-assets-cloudbuild.pages.dev",
    "deploy": "wrangler pages deploy dist-pages --project-name posewear-cloudbuild",
    "deploy:originals": "wrangler --cwd dist-originals pages deploy . --project-name posewear-assets-cloudbuild"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "wrangler": "^4.0.0"
  }
}
